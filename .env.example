# Copy to .env.local for local dev. Never commit .env.local.

# ---- Auth ----
# Generate: openssl rand -base64 32
AUTH_SECRET=replace_me_with_random_32_byte_secret
AUTH_URL=http://localhost:3000

# ---- Database (matches docker-compose defaults) ----
DATABASE_URL=postgres://timeline:timeline_dev@localhost:5432/timeline

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=dev_qdrant_key

# ---- RustFS (S3-compatible) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=timeline
S3_SECRET_ACCESS_KEY=timeline_dev_secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_AUDIO=timeline-audio
S3_BUCKET_ATTACHMENTS=timeline-attachments
S3_BUCKET_EXPORTS=timeline-exports

# ---- OpenRouter (chat, embeddings, transcription) ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Pin these. Changing EMBEDDING_MODEL or EMBEDDING_DIMENSIONS requires a
# documented re-embed of the entire vector store.
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
TRANSCRIPTION_MODEL=openai/whisper-1
CHAT_MODEL_DEFAULT=anthropic/claude-sonnet-4.5

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Generate: openssl rand -hex 32. Sent in X-Telegram-Bot-Api-Secret-Token header
# when setting webhook; verify on every inbound request.
TELEGRAM_WEBHOOK_SECRET=

# ---- Postmark (inbound email) ----
POSTMARK_SERVER_TOKEN=
POSTMARK_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=in.thetimeline.app

# ---- App ----
NODE_ENV=development
LOG_LEVEL=debug
