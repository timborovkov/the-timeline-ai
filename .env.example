# Copy to .env for local dev. Never commit .env.
# Each block links to a detailed walkthrough where applicable.

# =============================================================================
# Auth — required
# =============================================================================
# Generate: openssl rand -base64 32
AUTH_SECRET=replace_me_with_random_32_byte_secret
AUTH_URL=http://localhost:3000

# Optional GitHub OAuth provider. If both are set, the sign-in screen shows a
# "Continue with GitHub" button. Create an OAuth App at
# https://github.com/settings/developers — callback URL must be
# <AUTH_URL>/api/auth/callback/github.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# =============================================================================
# Database — required (matches docker-compose defaults)
# =============================================================================
DATABASE_URL=postgres://timeline:timeline_dev@localhost:5432/timeline

# =============================================================================
# Redis — required (BullMQ job queue; matches docker-compose defaults)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Qdrant — used Phase 5+
# =============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=dev_qdrant_key
# Collection used by the embed worker and /api/search. The re-embed
# procedure in docs/setup/openrouter.md creates a new collection and flips
# this var on cutover. Never rename without following that procedure.
QDRANT_COLLECTION=events

# =============================================================================
# RustFS / S3 — used Phase 3+ (audio, attachments, exports)
# =============================================================================
S3_ENDPOINT=http://localhost:9000
# Public HTTPS endpoint used when signing URLs handed to the browser
# (uploads, playback). Leave unset locally — S3_ENDPOINT is reused. In
# production, set this to a publicly reachable HTTPS URL for the same
# bucket; S3_ENDPOINT can remain the private (HTTP) intra-cluster host.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=timeline
S3_SECRET_ACCESS_KEY=timeline_dev_secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_AUDIO=timeline-audio
S3_BUCKET_ATTACHMENTS=timeline-attachments
S3_BUCKET_EXPORTS=timeline-exports
# Phase 9 — team document drive. Object keys are versioned and immutable;
# keep this bucket separate from attachments so lifecycle policies can diverge.
S3_BUCKET_DOCUMENTS=timeline-documents

# =============================================================================
# OpenRouter — used Phase 3+ (chat, embeddings, transcription)
# Setup: docs/setup/openrouter.md
# =============================================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Pin these. Changing EMBEDDING_MODEL or EMBEDDING_DIMENSIONS requires a
# documented re-embed of the entire vector store (see docs/setup/openrouter.md).
EMBEDDING_MODEL=perplexity/pplx-embed-v1-4b
EMBEDDING_DIMENSIONS=2560
TRANSCRIPTION_MODEL=openai/whisper-large-v3
CHAT_MODEL_DEFAULT=qwen/qwen3.7-max
# Extraction (Phase 4): cheap model for high-volume fact extraction. Falls
# back to CHAT_MODEL_DEFAULT when unset.
EXTRACTION_MODEL=deepseek/deepseek-v4-flash
# Agent chat (Phase 6): model used by /api/chat. Lets us point chat at a
# stronger model than extraction without changing extraction behavior.
# Falls back to CHAT_MODEL_DEFAULT then 'openai/gpt-4o-mini'.
AGENT_MODEL=qwen/qwen3.7-max
# Vision (Phase 9): model used by the documentExtract worker for OCR /
# PDF transcription. Falls back to CHAT_MODEL_DEFAULT then
# 'openai/gpt-4o-mini'. gpt-4o-mini is the cheapest viable default;
# anthropic/claude-3-5-sonnet handles dense layouts (forms, tables) more
# faithfully at ~5x the cost. Vision tokens are 5-10x text tokens —
# changing this is a deliberate cost decision.
VISION_MODEL=openai/gpt-4o-mini

# =============================================================================
# Telegram bot — used Phase 2+
# Setup: docs/setup/telegram.md
# =============================================================================
# Create a bot via @BotFather on Telegram (/newbot), paste the HTTP API token.
TELEGRAM_BOT_TOKEN=
# Generate: openssl rand -hex 32. Sent in X-Telegram-Bot-Api-Secret-Token header
# when setting webhook; verified on every inbound request.
TELEGRAM_WEBHOOK_SECRET=
# Bot's @username without the @ (BotFather → /mybots → your bot). Used to render
# `t.me/<username>?start=<token>` deep links in the team settings UI.
TELEGRAM_BOT_USERNAME=

# =============================================================================
# Postmark email: inbound timeline capture + outbound team invites
# Setup: docs/setup/postmark.html
# =============================================================================
POSTMARK_SERVER_TOKEN=
TRANSACTIONAL_EMAIL_FROM=
POSTMARK_WEBHOOK_SECRET=
# Public support/contact form destination and verified Postmark sender.
# Production support submissions are sent From/To this address, with Reply-To
# set to the visitor's email. Requires POSTMARK_SERVER_TOKEN.
SUPPORT_EMAIL=
# Production: own a domain, point MX at Postmark, set this. Each team's
# address becomes `<slug>@<this-domain>`.
INBOUND_EMAIL_DOMAIN=in.thetimeline.app
# Dev / no-own-domain fallback. Set to your Postmark server's default
# inbound address (e.g. `<hex>@inbound.postmarkapp.com`). Users address
# the team as `<hex>+<slug>@inbound.postmarkapp.com`; Postmark sets
# MailboxHash from the part after `+` and the dispatcher routes by slug.
# Safe to leave both this AND INBOUND_EMAIL_DOMAIN set — MailboxHash
# routing is tried first, then recipient-domain matching.
POSTMARK_INBOUND_ADDRESS=
# Comma-separated authserv-ids whose `Authentication-Results` headers we
# trust for SPF/DKIM verdicts. RFC 8601 §5 requires this allowlist —
# without it, an attacker can forge an `Authentication-Results` header in
# the email MIME body and bypass our spoof-defense. Inspect a real Postmark
# inbound payload to find the exact authserv-id Postmark stamps (commonly
# their inbound hostname). When unset, no AR header is trusted and we fall
# back to From-match (the dev / staging behavior).
POSTMARK_AUTHSERV_IDS=

# =============================================================================
# Cloudflare Turnstile — public abuse controls (Phase 13)
# =============================================================================
# Used only on anonymous/public forms: email/password registration and public
# support/contact. OAuth signup and signed-in app flows rely on rate limits,
# quota checks, and permissions instead.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =============================================================================
# Recall.ai meeting bots (Phase 10) — optional
# Setup: docs/setup/meeting-bots.html
# When unset, /app/meetings shows "not configured" and the scheduleMeetingBot
# server action refuses to start a bot.
# =============================================================================
RECALL_API_KEY=
# Region URL — default is us-west-2 per Recall's docs. Override for EU regions.
RECALL_BASE_URL=https://us-west-2.recall.ai/api/v1
# Svix signing secret for the bot lifecycle webhook (POST /api/webhooks/recall/status).
# Recall stamps this from the dashboard webhook config — typically `whsec_<base64>`.
RECALL_STATUS_WEBHOOK_SECRET=
# Optional override for the transcript webhook URL. When unset (the common
# case), the URL is derived from `AUTH_URL` + the fixed route path
# `/api/webhooks/recall/transcript`. Set this only when transcripts should
# hit a different origin than AUTH_URL (proxy, tunnel for local dev,
# separate ingress for webhook traffic).
RECALL_TRANSCRIPT_WEBHOOK_URL=
# Display name the bot uses in the participant list. The bot still appears as a
# participant in silent mode — set a recognisable name.
RECALL_BOT_DISPLAY_NAME=Timeline

# =============================================================================
# Sentry — optional, recommended before production
# Setup: docs/setup/sentry.md
# =============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# =============================================================================
# Phase 11 — Third-party integrations + custom MCP servers
# Setup: docs/setup/integrations.html
# =============================================================================
# AES-256-GCM key (32 bytes, base64) for encrypting integration auth secrets
# at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED when any integration or MCP server is configured.
SECRETS_ENCRYPTION_KEY=

# Google Drive OAuth (web application client). Redirect:
#   {AUTH_URL}/api/integrations/google_drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HMAC secret for Google Drive push-channel tokens. The drive watch
# registration mints x-goog-channel-token = `<integration_id>.<HMAC-SHA256
# (secret, integration_id)>` so a leaked integration UUID alone cannot
# trigger sync. Required to accept Drive webhooks at all — the handler
# refuses inbound notifications when this is unset.
GOOGLE_DRIVE_WEBHOOK_SECRET=

# Linear OAuth + webhook. Redirect:
#   {AUTH_URL}/api/integrations/linear/callback
# Webhook: {AUTH_URL}/api/webhooks/linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# GitHub OAuth + webhook. Callback:
#   {AUTH_URL}/api/integrations/github/callback
# Webhook: {AUTH_URL}/api/webhooks/github
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional: pre-registered OAuth client per known MCP server origin. Format:
#   MCP_PREREGISTERED_<NAME>_ORIGIN=https://...
#   MCP_PREREGISTERED_<NAME>_CLIENT_ID=...
#   MCP_PREREGISTERED_<NAME>_CLIENT_SECRET=...    # optional (public clients)
# When set, the MCP OAuth start route skips dynamic client registration
# (RFC 7591) for that origin and uses the pre-registered client info.
# Read lazily from process.env — no restart needed when adding entries.

# Timeline-as-MCP-server (outbound). Nothing to configure server-side: the
# /api/mcp/server endpoint mints `tla_*` bearer keys at runtime from
# /app/team/mcp-share and stores them as SHA-256 hashes in
# mcp_outbound_keys. External agents (Claude Desktop, Cursor, etc.)
# point at <AUTH_URL>/api/mcp/server with the bearer key in
# Authorization: Bearer tla_...

# =============================================================================
# App
# =============================================================================
NODE_ENV=development
LOG_LEVEL=debug
