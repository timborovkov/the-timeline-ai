# Copy to .env for local dev. Never commit .env.
# Detailed setup lives under docs/setup/.

# =============================================================================
# Environment
# =============================================================================
NODE_ENV=development
# Fail-closed default for Timeline-operated hosting. A separately licensed and
# operated production deployment may explicitly use self-managed so its
# operator owns provider, retention, access, backup, and notice decisions.
TIMELINE_DEPLOYMENT_MODE=hosted
# Keep false until G-20 in docs/security-privacy-trust.md is resolved and dated
# official registry evidence is retained. This is an operator attestation, not
# a substitute for that evidence; production otherwise withholds binding Terms,
# legal acceptance, and first-time account signup.
LEGAL_PUBLICATION_READY=false
LOG_LEVEL=debug
# Normally unset. Exact acknowledgement required for demo seed/verification
# against an isolated non-local database or Qdrant stack.
ALLOW_DEV_SEED=
# Normally unset. Exact acknowledgement required before the demo seed writes
# to a non-local S3 endpoint or any documents bucket other than timeline-documents.
ALLOW_DEV_SEED_STORAGE=

# =============================================================================
# Auth — required
# =============================================================================
# Generate: openssl rand -base64 32
AUTH_SECRET=replace_me_with_random_32_byte_secret
AUTH_URL=http://localhost:3000
# Exact plain-text token supplied by OpenAI's plugin submission portal for domain verification.
OPENAI_APPS_CHALLENGE_TOKEN=

# Optional GitHub sign-in. Production callback:
# https://thetimeline.cc/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# =============================================================================
# Database — required (matches docker-compose defaults)
# =============================================================================
DATABASE_URL=postgres://timeline:timeline_dev@localhost:5432/timeline
# Compose only: keep postgres_data unless following docs/setup/postgres18.md.
# Existing PG16 data must be dumped/restored into postgres18_data before cutover.
POSTGRES_DATA_VOLUME=postgres_data

# =============================================================================
# Redis — required (BullMQ job queue; matches docker-compose defaults)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Qdrant
# =============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=dev_qdrant_key
# Default collection for embeddings/search. The app auto-creates it with the
# catalog embedding dimensions, on-disk original vectors, scalar int8
# quantization in RAM, on-disk payload, and a team_id tenant payload index
# on first write. Existing collections are not rewritten — create a new
# collection and copy points (or reembed) before switching this name.
QDRANT_COLLECTION=events
# scalar (default) or binary. Binary needs higher search oversampling.
QDRANT_QUANTIZATION=scalar
# Search-time rescore of quantized hits against the original on-disk vectors.
QDRANT_QUANTIZATION_RESCORE=true
# Extra quantized candidates before rescore. Blank uses 2 (scalar) or 4 (binary).
# Qdrant rejects values below 1.
QDRANT_QUANTIZATION_OVERSAMPLING=
# Operator-only: allow qdrant-migrate-collection against a non-loopback Qdrant
# (isolated staging). Never set this in production.
ALLOW_QDRANT_MIGRATE_REMOTE=
# Operator process only; never a persistent web/worker service variable.
# Production --production also requires --copy --verify --all-teams
# --writers-paused and creates a source snapshot before writing the target.
# Value: I_UNDERSTAND_THIS_MIGRATES_PRODUCTION_QDRANT
ALLOW_QDRANT_MIGRATE_PRODUCTION=

# =============================================================================
# RustFS / S3
# =============================================================================
S3_ENDPOINT=http://localhost:9000
# Public HTTPS endpoint for browser-facing signed URLs. Leave unset locally.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=timeline
S3_SECRET_ACCESS_KEY=timeline_dev_secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_AUDIO=timeline-audio
S3_BUCKET_ATTACHMENTS=timeline-attachments
S3_BUCKET_EXPORTS=timeline-exports
S3_BUCKET_DOCUMENTS=timeline-documents

# =============================================================================
# OpenRouter
# Setup: docs/setup/openrouter.html
# =============================================================================
OPENROUTER_API_KEY=
# Required in Timeline-hosted production whenever OPENROUTER_API_KEY is set.
# Use the official guardrail id assigned to this exact inference key (never a
# management key). A self-managed operator owns its provider/proxy controls.
OPENROUTER_GUARDRAIL_ID=
# Generate after the separate provider-side allowlist/guardrail verification:
# bun run openrouter:attestation -- --env-file=/absolute/path/to/operator.env
# The hosted-only non-secret token invalidates on key, guardrail, catalog, or
# policy drift. Self-managed deployments must document their own equivalent.
OPENROUTER_PRIVACY_POLICY_ATTESTATION=
# Categories classify new tasks and show in the UI unless the kill switch is
# true. Historical backfill stays off; the CLI dry-runs until --enqueue and
# --max-cost-usd. An explicit false here overrides the code default.
TASK_CATEGORY_DISABLED=false
TASK_CATEGORY_CLASSIFICATION_ENABLED=true
TASK_CATEGORY_AUTO_ENQUEUE_ENABLED=true
TASK_CATEGORY_WORKER_ENABLED=true
TASK_CATEGORY_BACKFILL_ENABLED=false
TASK_CATEGORY_UI_ENABLED=true
CROSS_SOURCE_EVIDENCE_MODE=off
# Hosted production is pinned to the official origin. Self-managed production
# may use an operator-owned OpenRouter-compatible endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# Document extract / Daytona (ADR 0013)
# =============================================================================
# full = normal worker set; document-extract = credential-thin extract service
WORKER_MODE=full
# On the main Railway worker, set false when a dedicated extract service owns
# the document-extract queue.
DOCUMENT_EXTRACT_ENABLED=true
# Dev-only escape hatch when Daytona is unset (true/1). Rejected when
# NODE_ENV=production. A full worker with DOCUMENT_EXTRACT_ENABLED but no
# DAYTONA_API_KEY skips the document-extract consumer instead of falling
# through to in-process vision.
DOCUMENT_EXTRACT_ALLOW_INPROCESS=false
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
# Unset / auto / content-hash → timeline-document-extract-<sandboxHash>.
# Use auto on Railway so each deployed extractor resolves its matching snapshot.
DAYTONA_SNAPSHOT=
# extract-main: create-once if the named snapshot is missing (default true).
DAYTONA_SNAPSHOT_ENSURE=true
# Maintenance CLI only; comma-separated hashes for every deployed extractor.
# Do not set this as a Railway service variable.
DAYTONA_ACTIVE_SNAPSHOTS=
DOCUMENT_EXTRACT_SPARSE_TEXT_CHARS=500
DOCUMENT_EXTRACT_MAX_VISION_PAGES=20

# =============================================================================
# LangSmith LLM observability — development and evaluation only
# =============================================================================
# Rich traces include private prompt/output content from timeline events,
# documents, meetings, and integrations. Production env validation rejects
# LANGSMITH_TRACING=true. Raw media/audio bytes are redacted from development
# traces, and embeddings are not sent to LangSmith by default.
LANGSMITH_TRACING=false
# Optional global down-sampling when tracing is enabled. 0 disables trace writes;
# 1 keeps every eligible non-embedding trace.
LANGSMITH_TRACING_SAMPLING_RATE=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=timeline-development
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Required only for org-scoped LangSmith API keys.
LANGSMITH_WORKSPACE_ID=

# =============================================================================
# Telegram bot
# Setup: docs/setup/telegram.html
# =============================================================================
# Required by both web (webhook acknowledgement) and worker (durable direct-chat
# typing/replies). Use the same BotFather token in both Railway services.
TELEGRAM_BOT_TOKEN=
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Bot @username without the @.
TELEGRAM_BOT_USERNAME=
# Optional secret-protected webhook capture canary. The user id must already be
# linked to an active Timeline team in the same app/database.
TELEGRAM_CAPTURE_CANARY_USER_ID=
TELEGRAM_CAPTURE_CANARY_USERNAME=
TELEGRAM_CAPTURE_CANARY_FIRST_NAME=
# Required only when AUTH_URL is HTTPS; must exactly match AUTH_URL's origin.
TELEGRAM_CAPTURE_CANARY_ALLOWED_ORIGIN=

# =============================================================================
# Slack conversational capture — optional first-party bot surface
# Setup: docs/setup/slack.html
# =============================================================================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Optional read-only live canary tokens for `bun run canary:integrations`.
# These are not used by the product runtime; installed workspace tokens stay encrypted in the DB.
SLACK_CANARY_BOT_TOKEN=
SLACK_CANARY_USER_TOKEN=
# Optional signed-event capture canary. These IDs must point at an installed Slack
# workspace, a bound channel, and a real Slack user in the same app/database.
SLACK_CAPTURE_CANARY_TEAM_ID=
SLACK_CAPTURE_CANARY_CHANNEL_ID=
SLACK_CAPTURE_CANARY_USER_ID=
# Required only when AUTH_URL is HTTPS; must exactly match AUTH_URL's origin.
SLACK_CAPTURE_CANARY_ALLOWED_ORIGIN=

# =============================================================================
# Resend email
# Setup: docs/setup/resend.html
# =============================================================================
RESEND_API_KEY=
# Sender for all outgoing email, including invitations.
TRANSACTIONAL_EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
# Support recipient and all public contact links. Configure forwarding/routing separately.
SUPPORT_EMAIL=
# Production inbound domain. Team addresses use <slug>@<this-domain>.
INBOUND_EMAIL_DOMAIN=
# Optional replay canary: an existing synthetic received email addressed to a test team.
RESEND_INBOUND_CANARY_EMAIL_ID=
# Must match AUTH_URL origin. Replay can create captured events.
RESEND_INBOUND_CANARY_ALLOWED_ORIGIN=

# =============================================================================
# Cron / admin endpoints
# =============================================================================
# Optional bearer secret for protected cron endpoints such as /api/cron/reconcile.
CRON_SECRET=

# =============================================================================
# Cloudflare Turnstile
# =============================================================================
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =============================================================================
# Recall.ai meeting bots
# Setup: docs/setup/meeting-bots.html
# =============================================================================
RECALL_API_KEY=
# Hosted production accepts only Recall's official US West, US East, EU, and
# Japan HTTPS regional /api/v1 endpoints.
RECALL_BASE_URL=https://us-west-2.recall.ai/api/v1
# Exact provider-issued workspace verification secret used for both status and
# realtime transcript webhook signatures. Timeline rejects malformed or weak
# values below 24 decoded bytes. Required whenever meeting bots are enabled.
RECALL_WORKSPACE_VERIFICATION_SECRET=
# Legacy dashboard endpoint secret for accounts created before 2025-12-15.
# Status-only fallback; it never authenticates realtime transcript events.
RECALL_STATUS_WEBHOOK_SECRET=
# Optional transcript webhook override; defaults to the AUTH_URL route. Hosted
# production requires the same HTTPS origin and exact fixed route. Alternate
# proxy/tunnel ingress is available only in development or self-managed mode.
RECALL_TRANSCRIPT_WEBHOOK_URL=
# Recording-media retention on Recall. Empty => 1 hour. Production with
# TIMELINE_DEPLOYMENT_MODE=hosted rejects every explicit value except 1.
# Development or an explicit self-managed deployment may choose positive hours
# or "forever" and assumes responsibility for the resulting retention policy.
# Zero retention is intentionally unsupported because it disables Recall's
# multilingual prioritize_accuracy transcription path.
RECALL_RETENTION=
RECALL_BOT_DISPLAY_NAME=Timeline

# =============================================================================
# Polar usage billing (sandbox or production)
# Setup: docs/setup/polar.html
# =============================================================================
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=
POLAR_WEBHOOK_ID=
# bun run billing:polar-setup attaches timeline_extra_member_days (€2 / member-month) to these three
# and creates Timeline Enterprise (custom platform fee + the same six meters).
POLAR_PRODUCT_ID_PAYG=
POLAR_PRODUCT_ID_TEAM=
POLAR_PRODUCT_ID_BUSINESS=
POLAR_PRODUCT_ID_ENTERPRISE=
# When true, spend-cap gates block costly work. Default false = shadow billing.
# Copy this non-secret toggle onto document-extract-orchestrator as well (allowlisted).
BILLING_CHARGES_ENABLED=false
# Comma-separated platform operators. Team owners are not enough. Empty denies everyone.
PLATFORM_ADMIN_EMAILS=

# =============================================================================
# Sentry — optional, recommended before production
# Setup: docs/setup/sentry.html
# =============================================================================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
# Optional CI/source-map upload settings. `bun run canary:integrations` also uses
# these for a read-only project lookup; the token needs project:read access to
# the configured org/project.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=

# =============================================================================
# PostHog analytics
# Setup: docs/setup/analytics.html
# =============================================================================
# Server/worker product events and fixed-stream surface counts. Generate the
# pseudonymization key with: openssl rand -base64 32
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
ANALYTICS_PSEUDONYMIZATION_KEY=

# Optional consented browser analytics on reviewed public pages only.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# =============================================================================
# Third-party integrations + custom MCP servers
# Setup: docs/setup/integrations.html
# =============================================================================
# AES-256-GCM key (32 bytes, base64) for encrypting integration auth secrets
# at rest and verification/invitation email retry payloads. Required for those
# emails and when any integration or MCP server is configured.
SECRETS_ENCRYPTION_KEY=

# Google Drive OAuth. Production redirect:
# https://thetimeline.cc/api/integrations/google_drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required to accept Google Drive webhooks.
GOOGLE_DRIVE_WEBHOOK_SECRET=

# Linear OAuth + webhook.
# Production redirect: https://thetimeline.cc/api/integrations/linear/callback
# Production webhook: https://thetimeline.cc/api/webhooks/linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# GitHub App OAuth plus signed native webhook delivery.
# Production callback: https://thetimeline.cc/api/integrations/github/callback
# Production webhook: https://thetimeline.cc/api/webhooks/github
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional fallback offload for repo syncs: when set, Timeline mints
# installation access tokens and keys GitHub sync budget by installation.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Monday.com OAuth.
# Production callback: https://thetimeline.cc/api/integrations/monday/callback
# Production webhook: https://thetimeline.cc/api/webhooks/monday?token=<MONDAY_WEBHOOK_SECRET>
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_WEBHOOK_SECRET=

# Slack native workspace ingestion reuses the Slack app credentials above.
# Production callback: https://thetimeline.cc/api/integrations/slack/callback

# Sentry native integration OAuth plus signed issue-alert webhooks.
# Production callback: https://thetimeline.cc/api/integrations/sentry/callback
# Production webhook: https://thetimeline.cc/api/webhooks/sentry
SENTRY_INTEGRATION_CLIENT_ID=
SENTRY_INTEGRATION_CLIENT_SECRET=

# Pause native provider sync after this many hours of consecutive counted
# failures (connectivity, auth, access_revoked, or permanent). Default 72.
# Rate limits and 5xx do not count. Set to 1 or more.
# INTEGRATION_HEALTH_PAUSE_AFTER_HOURS=72

# Optional: pre-registered OAuth client per known MCP server origin. Format:
#   MCP_PREREGISTERED_<NAME>_ORIGIN=https://...
#   MCP_PREREGISTERED_<NAME>_CLIENT_ID=...
#   MCP_PREREGISTERED_<NAME>_CLIENT_SECRET=...    # optional (public clients)

# Timeline-as-MCP-server needs no server-side env. Create bearer keys from
# /app/team/mcp-share and point clients at https://thetimeline.cc/api/mcp/server.

# Provider rollout lists. Empty disables the new governor or scheduled recovery.
# Monday retains its own 100-call cap; Slack never falls back to legacy polling.
INTEGRATION_REQUEST_GOVERNOR_PROVIDERS=google_drive,linear,github,monday,slack,sentry
INTEGRATION_RECOVERY_PROVIDERS=google_drive,linear,github,monday,slack,sentry
