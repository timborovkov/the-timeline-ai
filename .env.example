# Copy to .env for local dev. Never commit .env.
# Detailed setup lives under docs/setup/.

# =============================================================================
# Environment
# =============================================================================
NODE_ENV=development
LOG_LEVEL=debug
# Normally unset. Exact acknowledgement required for demo seed/verification
# against an isolated non-local database or Qdrant stack.
ALLOW_DEV_SEED=
# Normally unset. Exact acknowledgement required before the demo seed writes
# to a non-local S3 endpoint or any documents bucket other than timeline-documents.
ALLOW_DEV_SEED_STORAGE=

# =============================================================================
# Auth — required
# =============================================================================
# Generate: openssl rand -base64 32
AUTH_SECRET=replace_me_with_random_32_byte_secret
AUTH_URL=http://localhost:3000

# Optional GitHub sign-in. Production callback:
# https://thetimeline.cc/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# =============================================================================
# Database — required (matches docker-compose defaults)
# =============================================================================
DATABASE_URL=postgres://timeline:timeline_dev@localhost:5432/timeline

# =============================================================================
# Redis — required (BullMQ job queue; matches docker-compose defaults)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Qdrant
# =============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=dev_qdrant_key
# Default collection for embeddings/search. The app auto-creates it with the
# catalog embedding dimensions and a team_id tenant payload index on first
# write; create migration target collections manually before running reembed
# with --target-collection.
QDRANT_COLLECTION=events

# =============================================================================
# RustFS / S3
# =============================================================================
S3_ENDPOINT=http://localhost:9000
# Public HTTPS endpoint for browser-facing signed URLs. Leave unset locally.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=timeline
S3_SECRET_ACCESS_KEY=timeline_dev_secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_AUDIO=timeline-audio
S3_BUCKET_ATTACHMENTS=timeline-attachments
S3_BUCKET_EXPORTS=timeline-exports
S3_BUCKET_DOCUMENTS=timeline-documents

# =============================================================================
# OpenRouter
# Setup: docs/setup/openrouter.html
# =============================================================================
OPENROUTER_API_KEY=
TASK_CATEGORY_CLASSIFICATION_ENABLED=false
TASK_CATEGORY_AUTO_ENQUEUE_ENABLED=false
TASK_CATEGORY_WORKER_ENABLED=false
TASK_CATEGORY_BACKFILL_ENABLED=false
TASK_CATEGORY_UI_ENABLED=false
CROSS_SOURCE_EVIDENCE_MODE=off
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# Document extract / Daytona (ADR 0013)
# =============================================================================
# full = normal worker set; document-extract = credential-thin extract service
WORKER_MODE=full
# On the main Railway worker, set false when a dedicated extract service owns
# the document-extract queue.
DOCUMENT_EXTRACT_ENABLED=true
# Dev-only escape hatch when Daytona is unset (true/1). Rejected when
# NODE_ENV=production. A full worker with DOCUMENT_EXTRACT_ENABLED but no
# DAYTONA_API_KEY skips the document-extract consumer instead of falling
# through to in-process vision.
DOCUMENT_EXTRACT_ALLOW_INPROCESS=false
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
# Unset / auto / content-hash → timeline-document-extract-<sandboxHash>.
# Use auto on Railway so each deployed extractor resolves its matching snapshot.
DAYTONA_SNAPSHOT=
# extract-main: create-once if the named snapshot is missing (default true).
DAYTONA_SNAPSHOT_ENSURE=true
# Maintenance CLI only; comma-separated hashes for every deployed extractor.
# Do not set this as a Railway service variable.
DAYTONA_ACTIVE_SNAPSHOTS=
DOCUMENT_EXTRACT_SPARSE_TEXT_CHARS=500
DOCUMENT_EXTRACT_MAX_VISION_PAGES=20

# =============================================================================
# LangSmith LLM observability — optional, sensitive in production
# =============================================================================
# Rich traces include private prompt/output content from timeline events,
# documents, meetings, and integrations. Treat LangSmith access as operational
# access to sensitive product data. Raw media/audio bytes are redacted from
# traces, and embeddings are not sent to LangSmith by default.
LANGSMITH_TRACING=false
# Optional global down-sampling when tracing is enabled. 0 disables trace writes;
# 1 keeps every eligible non-embedding trace.
LANGSMITH_TRACING_SAMPLING_RATE=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=timeline-development
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Required only for org-scoped LangSmith API keys.
LANGSMITH_WORKSPACE_ID=

# =============================================================================
# Telegram bot
# Setup: docs/setup/telegram.html
# =============================================================================
# Required by both web (webhook acknowledgement) and worker (durable direct-chat
# typing/replies). Use the same BotFather token in both Railway services.
TELEGRAM_BOT_TOKEN=
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Bot @username without the @.
TELEGRAM_BOT_USERNAME=
# Optional secret-protected webhook capture canary. The user id must already be
# linked to an active Timeline team in the same app/database.
TELEGRAM_CAPTURE_CANARY_USER_ID=
TELEGRAM_CAPTURE_CANARY_USERNAME=
TELEGRAM_CAPTURE_CANARY_FIRST_NAME=
# Required only when AUTH_URL is HTTPS; must exactly match AUTH_URL's origin.
TELEGRAM_CAPTURE_CANARY_ALLOWED_ORIGIN=

# =============================================================================
# Slack conversational capture — optional first-party bot surface
# Setup: docs/setup/slack.html
# =============================================================================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Optional read-only live canary tokens for `pnpm canary:integrations`.
# These are not used by the product runtime; installed workspace tokens stay encrypted in the DB.
SLACK_CANARY_BOT_TOKEN=
SLACK_CANARY_USER_TOKEN=
# Optional signed-event capture canary. These IDs must point at an installed Slack
# workspace, a bound channel, and a real Slack user in the same app/database.
SLACK_CAPTURE_CANARY_TEAM_ID=
SLACK_CAPTURE_CANARY_CHANNEL_ID=
SLACK_CAPTURE_CANARY_USER_ID=
# Required only when AUTH_URL is HTTPS; must exactly match AUTH_URL's origin.
SLACK_CAPTURE_CANARY_ALLOWED_ORIGIN=

# =============================================================================
# Postmark email
# Setup: docs/setup/postmark.html
# =============================================================================
POSTMARK_SERVER_TOKEN=
TRANSACTIONAL_EMAIL_FROM=
POSTMARK_WEBHOOK_SECRET=
# Support/contact destination. Configure your forwarding/routing separately.
SUPPORT_EMAIL=
# Production inbound domain. Team addresses use <slug>@<this-domain>.
INBOUND_EMAIL_DOMAIN=
# Dev fallback: your Postmark server's default inbound address.
POSTMARK_INBOUND_ADDRESS=
# Comma-separated authserv-ids trusted for SPF/DKIM verdicts.
POSTMARK_AUTHSERV_IDS=
# Optional comma-separated Postmark webhook source CIDRs for inbound email hardening.
POSTMARK_INBOUND_IPS=
# Optional live inbound capture canary. The recipient must route to a canary team,
# and the sender must pass that team's inbound sender whitelist when enabled.
POSTMARK_INBOUND_CANARY_TO=
POSTMARK_INBOUND_CANARY_FROM=
POSTMARK_INBOUND_CANARY_ALLOWED_ORIGIN=

# =============================================================================
# Cron / admin endpoints
# =============================================================================
# Optional bearer secret for protected cron endpoints such as /api/cron/reconcile.
CRON_SECRET=

# =============================================================================
# Cloudflare Turnstile
# =============================================================================
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =============================================================================
# Recall.ai meeting bots
# Setup: docs/setup/meeting-bots.html
# =============================================================================
RECALL_API_KEY=
# Override for EU regions if needed.
RECALL_BASE_URL=https://us-west-2.recall.ai/api/v1
# Svix signing secret for POST /api/webhooks/recall/status.
RECALL_STATUS_WEBHOOK_SECRET=
# Optional transcript webhook override; defaults to AUTH_URL route.
RECALL_TRANSCRIPT_WEBHOOK_URL=
# Recording-media retention on Recall. Empty => 1 hour.
# Positive integer => timed retention in hours. "forever" => indefinite retention.
# Zero retention is intentionally unsupported because it disables Recall's
# multilingual prioritize_accuracy transcription path.
RECALL_RETENTION=
RECALL_BOT_DISPLAY_NAME=Timeline

# =============================================================================
# Polar usage billing (sandbox or production)
# Setup: docs/setup/polar.html
# =============================================================================
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=
POLAR_WEBHOOK_ID=
POLAR_PRODUCT_ID_PAYG=
POLAR_PRODUCT_ID_TEAM=
POLAR_PRODUCT_ID_BUSINESS=
POLAR_DISCOUNT_ID=
POLAR_DISCOUNT_CODE=
# When true, wallet/spend-cap gates block costly work. Default false = shadow billing.
BILLING_CHARGES_ENABLED=false

# =============================================================================
# Sentry — optional, recommended before production
# Setup: docs/setup/sentry.html
# =============================================================================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
# Optional CI/source-map upload settings. `pnpm canary:integrations` also uses
# these for a read-only project lookup; the token needs project:read access to
# the configured org/project.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=

# =============================================================================
# PostHog product analytics + feature flags
# Setup: docs/setup/analytics.html
# =============================================================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# =============================================================================
# Third-party integrations + custom MCP servers
# Setup: docs/setup/integrations.html
# =============================================================================
# AES-256-GCM key (32 bytes, base64) for encrypting integration auth secrets
# at rest. Required when any integration or MCP server is configured.
SECRETS_ENCRYPTION_KEY=

# Google Drive OAuth. Production redirect:
# https://thetimeline.cc/api/integrations/google_drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required to accept Google Drive webhooks.
GOOGLE_DRIVE_WEBHOOK_SECRET=

# Linear OAuth + webhook.
# Production redirect: https://thetimeline.cc/api/integrations/linear/callback
# Production webhook: https://thetimeline.cc/api/webhooks/linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# GitHub App OAuth plus signed native webhook delivery.
# Production callback: https://thetimeline.cc/api/integrations/github/callback
# Production webhook: https://thetimeline.cc/api/webhooks/github
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional fallback offload for repo syncs: when set, Timeline mints
# installation access tokens and keys GitHub sync budget by installation.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Monday.com OAuth.
# Production callback: https://thetimeline.cc/api/integrations/monday/callback
# Production webhook: https://thetimeline.cc/api/webhooks/monday?token=<MONDAY_WEBHOOK_SECRET>
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_WEBHOOK_SECRET=

# Slack native workspace ingestion reuses the Slack app credentials above.
# Production callback: https://thetimeline.cc/api/integrations/slack/callback

# Sentry native integration OAuth plus signed issue-alert webhooks.
# Production callback: https://thetimeline.cc/api/integrations/sentry/callback
# Production webhook: https://thetimeline.cc/api/webhooks/sentry
SENTRY_INTEGRATION_CLIENT_ID=
SENTRY_INTEGRATION_CLIENT_SECRET=

# Optional: pre-registered OAuth client per known MCP server origin. Format:
#   MCP_PREREGISTERED_<NAME>_ORIGIN=https://...
#   MCP_PREREGISTERED_<NAME>_CLIENT_ID=...
#   MCP_PREREGISTERED_<NAME>_CLIENT_SECRET=...    # optional (public clients)

# Timeline-as-MCP-server needs no server-side env. Create bearer keys from
# /app/team/mcp-share and point clients at https://thetimeline.cc/api/mcp/server.
