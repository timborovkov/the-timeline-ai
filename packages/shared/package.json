{
  "name": "@timeline/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*.js": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./integrations": {
      "import": "./dist/integrations/index.js",
      "types": "./dist/integrations/index.d.ts"
    },
    "./integrations/registry": {
      "import": "./dist/integrations/registry.js",
      "types": "./dist/integrations/registry.d.ts"
    },
    "./logger": {
      "import": "./dist/logger.js",
      "types": "./dist/logger.d.ts"
    },
    "./env": {
      "import": "./dist/env.js",
      "types": "./dist/env.d.ts"
    },
    "./env-reset": {
      "types": "./src/env-reset.ts",
      "development": "./src/env-reset.ts",
      "import": "./dist/env-reset.js",
      "default": "./dist/env-reset.js"
    },
    "./email": {
      "import": "./dist/email/index.js",
      "types": "./dist/email/index.d.ts"
    },
    "./passwords": {
      "import": "./dist/passwords.js",
      "types": "./dist/passwords.d.ts"
    },
    "./rate-limit": {
      "import": "./dist/rate-limit/index.js",
      "types": "./dist/rate-limit/index.d.ts"
    },
    "./slug": {
      "import": "./dist/slug.js",
      "types": "./dist/slug.d.ts"
    },
    "./s3/client": {
      "types": "./src/s3/client.ts",
      "development": "./src/s3/client.ts",
      "import": "./dist/s3/client.js",
      "default": "./dist/s3/client.js"
    },
    "./citation": {
      "import": "./dist/citation.js",
      "types": "./dist/citation.d.ts"
    },
    "./time": {
      "import": "./dist/time/index.js",
      "types": "./dist/time/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--conditions=development vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.67",
    "@ai-sdk/openai-compatible": "2.0.48",
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@timeline/db": "workspace:*",
    "ai": "^6.0.193",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.7",
    "drizzle-orm": "^0.45.2",
    "ioredis": "5.10.1",
    "jszip": "3.10.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
