{
  "name": "@timeline/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*.js": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./migrate": {
      "types": "./src/migrate.ts",
      "development": "./src/migrate.ts",
      "import": "./dist/migrate.js",
      "default": "./dist/migrate.js"
    },
    "./reset": {
      "types": "./src/reset.ts",
      "development": "./src/reset.ts",
      "import": "./dist/reset.js",
      "default": "./dist/reset.js"
    },
    "./wait-for-migrations": {
      "types": "./src/wait-for-migrations.ts",
      "development": "./src/wait-for-migrations.ts",
      "import": "./dist/wait-for-migrations.js",
      "default": "./dist/wait-for-migrations.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun x --bun --no-install tsc -p tsconfig.json",
    "dev": "bun x --bun --no-install tsc -p tsconfig.json --watch",
    "lint": "bun x --bun --no-install eslint src",
    "test": "bun ../../scripts/testing/run.ts packages/db",
    "typecheck": "bun x --bun --no-install tsc -p tsconfig.json --noEmit",
    "generate": "BUN_OPTIONS=\"--conditions=development\" bun x --bun --no-install drizzle-kit generate",
    "migrate": "BUN_OPTIONS=\"--conditions=development\" bun x --bun --no-install drizzle-kit migrate",
    "studio": "BUN_OPTIONS=\"--conditions=development\" bun x --bun --no-install drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "@timeline/test-support": "workspace:*",
    "@types/bun": "1.4.4"
  }
}
