{
  "name": "@timeline/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*.js": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./migrate": {
      "types": "./src/migrate.ts",
      "development": "./src/migrate.ts",
      "import": "./dist/migrate.js",
      "default": "./dist/migrate.js"
    },
    "./reset": {
      "types": "./src/reset.ts",
      "development": "./src/reset.ts",
      "import": "./dist/reset.js",
      "default": "./dist/reset.js"
    },
    "./wait-for-migrations": {
      "types": "./src/wait-for-migrations.ts",
      "development": "./src/wait-for-migrations.ts",
      "import": "./dist/wait-for-migrations.js",
      "default": "./dist/wait-for-migrations.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "test": "NODE_OPTIONS=--conditions=development vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "NODE_OPTIONS=--conditions=development drizzle-kit generate",
    "migrate": "NODE_OPTIONS=--conditions=development drizzle-kit migrate",
    "studio": "NODE_OPTIONS=--conditions=development drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@types/node": "^26.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
