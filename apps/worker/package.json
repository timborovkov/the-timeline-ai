{
  "name": "@timeline/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*.js": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "bun x --bun --no-install tsc -p tsconfig.json && bun run sentry:sourcemaps",
    "sentry:sourcemaps": "bun scripts/upload-sentry-sourcemaps.mjs",
    "dev": "bun --conditions=development --watch src/index.ts",
    "start": "bun dist/index.js",
    "reextract": "bun --conditions=development src/scripts/reextract.ts",
    "reembed": "bun --conditions=development src/scripts/reembed.ts",
    "qdrant-migrate-collection": "bun --conditions=development src/scripts/qdrant-migrate-collection.ts",
    "resuggest": "bun --conditions=development src/scripts/resuggest.ts",
    "dedupe-approvals": "bun --conditions=development src/scripts/dedupe-approvals.ts",
    "dedupe-calendar-events": "bun --conditions=development src/scripts/dedupe-calendar-events.ts",
    "embed-coverage": "bun --conditions=development src/scripts/embed-coverage.ts",
    "demo-index": "bun --conditions=development src/scripts/demo-index.ts",
    "reconciliation-evidence": "bun --conditions=development src/scripts/reconciliation-evidence.ts",
    "reconciliation-legacy-provenance": "bun --conditions=development src/scripts/reconciliation-legacy-provenance.ts",
    "reconciliation-production-sampling": "bun --conditions=development src/scripts/reconciliation-production-sampling.ts",
    "redocument-extract": "bun --conditions=development src/scripts/redocument-extract.ts",
    "redocument-embed": "bun --conditions=development src/scripts/redocument-embed.ts",
    "integration-resync": "bun --conditions=development src/scripts/integration-resync.ts",
    "timeline-moment-presentations": "bun --conditions=development src/scripts/timeline-moment-presentations.ts",
    "task-category-backfill": "bun --conditions=development src/scripts/task-category-backfill.ts",
    "create-document-extract-snapshot": "bun --conditions=development scripts/create-document-extract-snapshot.ts",
    "ensure-document-extract-snapshot": "bun --conditions=development scripts/create-document-extract-snapshot.ts",
    "cleanup-document-extract-snapshots": "bun --conditions=development scripts/cleanup-document-extract-snapshots.ts",
    "dev:extract": "WORKER_MODE=document-extract bun --conditions=development --watch src/extract-main.ts",
    "start:extract": "WORKER_MODE=document-extract bun dist/extract-main.js",
    "lint": "bun x --bun --no-install eslint src",
    "test": "bun ../../scripts/testing/run.ts apps/worker",
    "typecheck": "bun x --bun --no-install tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.226.0",
    "@sentry/node": "^11.9.0",
    "@timeline/db": "workspace:*",
    "@timeline/shared": "workspace:*",
    "bullmq": "6.4.2",
    "drizzle-orm": "^0.45.4",
    "ffmpeg-static": "^5.3.0",
    "mammoth": "^1.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "@timeline/test-support": "workspace:*",
    "@types/bun": "1.4.4"
  }
}
