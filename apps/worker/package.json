{
  "name": "@timeline/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "reextract": "tsx src/scripts/reextract.ts",
    "reembed": "tsx src/scripts/reembed.ts",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@timeline/db": "workspace:*",
    "@timeline/shared": "workspace:*",
    "bullmq": "^5.0.0",
    "drizzle-orm": "^0.38.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "*"
  }
}
