{
  "name": "@timeline/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "reextract": "tsx src/scripts/reextract.ts",
    "reembed": "tsx src/scripts/reembed.ts",
    "embed-coverage": "tsx src/scripts/embed-coverage.ts",
    "redocument-extract": "tsx src/scripts/redocument-extract.ts",
    "redocument-embed": "tsx src/scripts/redocument-embed.ts",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@timeline/db": "workspace:*",
    "@timeline/shared": "workspace:*",
    "bullmq": "^5.0.0",
    "drizzle-orm": "^0.38.0",
    "mammoth": "^1.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "*",
    "vitest": "^4.1.6"
  }
}
