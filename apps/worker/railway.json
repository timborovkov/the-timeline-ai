{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/worker.Dockerfile"
  },
  "deploy": {
    "preDeployCommand": ["NODE_ENV=production bun --no-env-file packages/db/dist/migrate.js"],
    "startCommand": "NODE_ENV=production bun --no-env-file apps/worker/dist/index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
