{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/web.Dockerfile"
  },
  "deploy": {
    "preDeployCommand": ["NODE_ENV=production bun --no-env-file packages/db/dist/migrate.js"],
    "startCommand": "NODE_ENV=production bun --no-env-file apps/web/start.mjs",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "variables": {
    "HOSTNAME": "0.0.0.0"
  }
}
