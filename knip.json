{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.{js,ts}", "scripts/testing/*.ts", "scripts/performance/*.mjs"],
      "entry": ["scripts/testing/*.ts", "scripts/performance/*.mjs"]
    },
    "apps/web": {
      "entry": [
        "src/app/**/{page,route,layout,loading,error,not-found,template,default,sitemap,robots,manifest,icon,apple-icon,opengraph-image,twitter-image}.{ts,tsx,js,jsx}",
        "src/app/actions/*.ts",
        "src/lib/public-site/index.ts",
        "src/proxy.{ts,tsx}",
        "scripts/*.{ts,mjs}",
        "postcss.config.{js,mjs,cjs,ts}",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignore": ["src/components/ui/**"]
    },
    "apps/worker": {
      "entry": [
        "scripts/*.mjs",
        "scripts/*.ts",
        "src/scripts/*.ts",
        "src/workers/*.test.ts",
        "src/document-ingestion/*.test.ts",
        "src/**/*.test.{ts,tsx}",
        "src/index.ts",
        "src/extract-main.ts"
      ],
      "project": ["scripts/*.{mjs,ts}", "src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/schema/**/*.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.ts"]
    },
    "packages/shared": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["pino-pretty"]
    }
  }
}
