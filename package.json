{
  "name": "timeline",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "knip": "DATABASE_URL=${DATABASE_URL:-postgres://placeholder@localhost:5432/placeholder} knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm knip",
    "dev:wipe": "NODE_OPTIONS=--conditions=development node --import tsx scripts/env-reset.ts",
    "db:migrate": "pnpm --filter @timeline/db migrate",
    "db:generate": "pnpm --filter @timeline/db generate",
    "db:studio": "pnpm --filter @timeline/db studio"
  },
  "devDependencies": {
    "@timeline/db": "workspace:*",
    "@timeline/shared": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.15.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  }
}
