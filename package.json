{
  "name": "timeline",
  "version": "0.1.0",
  "private": true,
  "license": "Elastic-2.0",
  "packageManager": "bun@1.4.6",
  "type": "module",
  "scripts": {
    "deps": "bun install",
    "dev": "turbo run dev --env-mode=loose",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "bun scripts/testing/run.ts",
    "test:ci": "bun run test:e2e-env && bun run test:demo-fixture && bun run test:eval && bun run test:reconciliation-eval && bun run test:dist-imports",
    "test:eval": "bun --conditions=development scripts/testing/run.ts src/agent/evals.test.ts src/agent/ask.test.ts src/agent/surface-evals.test.ts src/objects/summary-evals.test.ts src/task-categories/evals.test.ts src/team-scope.search.test.ts && bun --conditions=development scripts/testing/run.ts src/agent/mcp-evals.test.ts && bun --conditions=development scripts/testing/run.ts src/app/api/chat/route.test.ts && bun --conditions=development scripts/testing/run.ts src/workers/suggestions.evals.test.ts",
    "test:task-category-eval:live": "TASK_CATEGORY_LIVE_EVAL=1 bun --conditions=development scripts/testing/run.ts src/task-categories/live-eval.test.ts --live",
    "test:freshness-eval:live": "FRESHNESS_LIVE_EVAL=1 bun --conditions=development scripts/testing/run.ts src/agent/freshness.live-eval.test.ts --live",
    "test:agent-eval:live": "AGENT_LIVE_EVAL=1 bun --conditions=development scripts/testing/run.ts src/agent/live-eval.test.ts --live",
    "test:suggestions-eval:live": "SUGGESTIONS_LIVE_EVAL=1 bun --conditions=development scripts/testing/run.ts src/workers/suggestions.live-eval.test.ts --live",
    "test:proposal-engine:live": "PROPOSAL_ENGINE_LIVE_EVAL=1 bun --conditions=development scripts/testing/run.ts src/workers/proposal-engine.live-eval.test.ts --live",
    "test:transcribe-eval:live": "TRANSCRIBE_LIVE_EVAL=1 bun --conditions=development scripts/testing/run.ts src/workers/transcribe.live-eval.test.ts --live",
    "eval:transcription-quality:live": "TRANSCRIPTION_QUALITY_EVAL_LIVE=1 bun --conditions=development apps/worker/src/scripts/transcription-quality-eval.ts",
    "test:reconciliation-eval": "bun --conditions=development scripts/testing/run.ts src/reconciliation/index.test.ts src/reconciliation/authority.test.ts src/reconciliation/dev-seed-contract.test.ts src/reconciliation/evals.test.ts src/reconciliation/live-artifacts.test.ts src/reconciliation/planner.test.ts src/reconciliation/production-sampling.test.ts src/reconciliation/stable-json.test.ts && bun --conditions=development scripts/testing/run.ts src/reconciliation/normalization.test.ts src/reconciliation/backfill.test.ts src/reconciliation/dashboard.test.ts src/reconciliation/mcp-capture.test.ts src/reconciliation/resolver.test.ts && bun --conditions=development scripts/testing/run.ts src/scripts/reconciliation-production-sampling.test.ts src/scripts/reconciliation-legacy-provenance.test.ts",
    "test:reconciliation-eval:live": "RECONCILIATION_LIVE_EVAL=1 bun --conditions=development scripts/testing/run.ts src/reconciliation/live-eval.test.ts --live",
    "test:dist-imports": "bun run --filter @timeline/db build && bun run --filter @timeline/shared build && bun scripts/check-dist-imports.mjs",
    "test:e2e-env": "bun scripts/e2e-env.test.ts",
    "check:web-bundle": "bun scripts/check-web-bundle-hygiene.ts",
    "check:public-origin": "bun --cwd apps/web --no-env-file --conditions=development scripts/check-public-origin.ts",
    "e2e": "bun scripts/run-e2e-strict.ts",
    "e2e:precompiled": "bun scripts/run-e2e-strict.ts --precompile-fixtures",
    "e2e:ui": "bun scripts/run-e2e-command.ts bun x --bun --no-install playwright test --ui",
    "e2e:prod-smoke": "bun scripts/run-e2e-prod-smoke.ts",
    "ops:restore-drill": "bun --no-env-file --conditions=development scripts/restore-drill.ts",
    "telegram:provision": "bun --no-env-file --conditions=development scripts/provision-telegram.ts",
    "canary:integrations": "bun --conditions=development scripts/check-live-integrations.ts",
    "canary:integrations:strict": "bun --conditions=development scripts/check-live-integrations.ts --strict",
    "openrouter:attestation": "bun --conditions=development scripts/print-openrouter-privacy-attestation.ts",
    "repair:monday": "bun --conditions=development scripts/repair-monday-helper-boards.ts",
    "billing:operator": "bun --conditions=development scripts/billing-operator.ts",
    "billing:polar-setup": "bun --conditions=development scripts/billing-polar-setup.ts",
    "e2e:setup": "bun scripts/run-e2e-command.ts bun e2e/setup.ts",
    "e2e:cleanup": "bun scripts/run-e2e-command.ts bun e2e/cleanup.ts",
    "knip": "DATABASE_URL=${DATABASE_URL:-postgres://placeholder@localhost:5432/placeholder} bun x --bun --no-install knip",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "validate": "bun fmt --check && bun run typecheck && bun run lint && bun run knip",
    "dev:wipe": "bun --conditions=development scripts/env-reset.ts",
    "dev:seed": "bun --conditions=development scripts/seed-dev.ts",
    "dev:seed:heavy": "bun --conditions=development scripts/seed-dev.ts --heavy",
    "demo:seed": "bun run dev:seed && bun run demo:index && bun run demo:verify",
    "demo:reset": "bun run dev:wipe && bun run demo:seed",
    "demo:index": "TIMELINE_ENV_FILE=$PWD/.env bun run --filter @timeline/worker demo-index -- --team=20000000-0000-4000-8000-000000000001 --fixture-version=demo-seed-v1",
    "demo:verify": "bun --conditions=development scripts/verify-demo.ts",
    "test:demo-fixture": "bun --conditions=development scripts/demo-fixture.test.ts",
    "db:migrate": "bun run --filter @timeline/db migrate",
    "db:generate": "bun run --filter @timeline/db generate",
    "db:studio": "bun run --filter @timeline/db studio",
    "doctor": "bun scripts/run-react-doctor.mjs",
    "test:runtime": "bun --bun --no-env-file --conditions=development apps/worker/scripts/runtime-smoke.ts",
    "billing:polar-convert": "bun --no-env-file --conditions=development scripts/billing-polar-convert.ts",
    "email:replay": "bun --conditions=development scripts/replay-inbound-email.ts",
    "capture:marketing-screenshots": "bun scripts/capture-marketing-screenshots.mjs",
    "test:website-scan:live": "WEBSITE_SCAN_LIVE_EVAL=1 bun --conditions=development scripts/testing/run.ts src/workers/websiteScan.live-eval.test.ts --live",
    "eval:sync": "bun --conditions=development packages/shared/src/scripts/task-category-experiment.ts --sync",
    "eval:compare": "bun --conditions=development packages/shared/src/scripts/task-category-experiment.ts",
    "eval:agent:sync": "bun --conditions=development packages/shared/src/scripts/agent-experiment.ts --sync",
    "eval:agent:compare": "bun --conditions=development packages/shared/src/scripts/agent-experiment.ts",
    "eval:suggestions:sync": "bun --conditions=development apps/worker/src/scripts/suggestion-experiment.ts --sync",
    "eval:suggestions:compare": "bun --conditions=development apps/worker/src/scripts/suggestion-experiment.ts"
  },
  "overrides": {
    "@babel/helper-compilation-targets": {
      "browserslist": "4.28.7"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.1"
    },
    "@sentry/cli": {
      "undici": "6.29.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "ajv": {
      "fast-uri": "3.1.9"
    },
    "browserslist": {
      "baseline-browser-mapping": "2.11.0"
    },
    "eslint": {
      "minimatch": "11.0.1"
    },
    "mammoth": {
      "@xmldom/xmldom": "0.8.15"
    },
    "pino-pretty": {
      "fast-copy": "4.1.0"
    },
    "postcss": {
      "source-map-js": "1.2.2"
    },
    "posthog-js": {
      "fflate": "0.4.9"
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@happy-dom/global-registrator": "21.0.4",
    "@playwright/test": "^1.65.1",
    "@sentry/cli": "3.8.2",
    "@testing-library/react": "^16.3.3",
    "@timeline/db": "workspace:*",
    "@timeline/shared": "workspace:*",
    "@types/bun": "1.4.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "bullmq": "6.7.8",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.47.0",
    "react-doctor": "^0.9.23",
    "turbo": "^2.11.13",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "bun": ">=1.4.6"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@sentry/cli",
    "esbuild",
    "ffmpeg-static",
    "msgpackr-extract",
    "protobufjs",
    "sharp"
  ]
}
