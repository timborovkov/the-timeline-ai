{
  "name": "timeline",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:ci": "pnpm test:eval && pnpm test:dist-imports",
    "test:eval": "pnpm --filter @timeline/shared test -- src/agent/evals.test.ts src/agent/ask.test.ts src/agent/mcp-evals.test.ts src/team-scope.search.test.ts",
    "test:dist-imports": "pnpm --filter @timeline/db build && pnpm --filter @timeline/shared build && node scripts/check-dist-imports.mjs",
    "check:web-bundle": "tsx scripts/check-web-bundle-hygiene.ts",
    "e2e": "tsx scripts/run-e2e-strict.ts",
    "e2e:ui": "env -u NO_COLOR DATABASE_URL=${DATABASE_URL:-postgres://timeline:timeline_dev@localhost:5432/timeline} AUTH_SECRET=${AUTH_SECRET:-e2e-auth-secret-at-least-sixteen-characters} NODE_OPTIONS=--conditions=development playwright test --ui",
    "e2e:prod-smoke": "tsx scripts/run-e2e-prod-smoke.ts",
    "e2e:setup": "env -u NO_COLOR DATABASE_URL=${DATABASE_URL:-postgres://timeline:timeline_dev@localhost:5432/timeline} NODE_OPTIONS=--conditions=development tsx e2e/setup.ts",
    "e2e:cleanup": "env -u NO_COLOR DATABASE_URL=${DATABASE_URL:-postgres://timeline:timeline_dev@localhost:5432/timeline} NODE_OPTIONS=--conditions=development tsx e2e/cleanup.ts",
    "knip": "DATABASE_URL=${DATABASE_URL:-postgres://placeholder@localhost:5432/placeholder} knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm knip",
    "dev:wipe": "NODE_OPTIONS=--conditions=development node --import tsx scripts/env-reset.ts",
    "db:migrate": "pnpm --filter @timeline/db migrate",
    "db:generate": "pnpm --filter @timeline/db generate",
    "db:studio": "pnpm --filter @timeline/db studio",
    "doctor": "react-doctor"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sentry/cli": "2.58.6",
    "@timeline/db": "workspace:*",
    "@timeline/shared": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.15.0",
    "prettier": "^3.8.3",
    "react-doctor": "^0.2.16",
    "tsx": "^4.22.4",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  }
}
