{
  "name": "timeline",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:ci": "pnpm test:eval && pnpm test:dist-imports",
    "test:eval": "NODE_OPTIONS=--conditions=development pnpm --filter @timeline/shared exec vitest run src/agent/evals.test.ts src/agent/ask.test.ts src/team-scope.search.test.ts --project pglite --maxWorkers=1 --no-file-parallelism && NODE_OPTIONS=--conditions=development pnpm --filter @timeline/shared exec vitest run src/agent/mcp-evals.test.ts --project unit --maxWorkers=1 --no-file-parallelism",
    "test:dist-imports": "pnpm --filter @timeline/db build && pnpm --filter @timeline/shared build && node scripts/check-dist-imports.mjs",
    "check:web-bundle": "tsx scripts/check-web-bundle-hygiene.ts",
    "e2e": "tsx scripts/run-e2e-strict.ts",
    "e2e:ui": "env -u NO_COLOR DATABASE_URL=${DATABASE_URL:-postgres://timeline:timeline_dev@localhost:5432/timeline} AUTH_SECRET=${AUTH_SECRET:-e2e-auth-secret-at-least-sixteen-characters} NODE_OPTIONS=--conditions=development playwright test --ui",
    "e2e:prod-smoke": "tsx scripts/run-e2e-prod-smoke.ts",
    "canary:integrations": "NODE_OPTIONS=--conditions=development tsx scripts/check-live-integrations.ts",
    "canary:integrations:strict": "NODE_OPTIONS=--conditions=development tsx scripts/check-live-integrations.ts --strict",
    "e2e:setup": "env -u NO_COLOR DATABASE_URL=${DATABASE_URL:-postgres://timeline:timeline_dev@localhost:5432/timeline} NODE_OPTIONS=--conditions=development tsx e2e/setup.ts",
    "e2e:cleanup": "env -u NO_COLOR DATABASE_URL=${DATABASE_URL:-postgres://timeline:timeline_dev@localhost:5432/timeline} NODE_OPTIONS=--conditions=development tsx e2e/cleanup.ts",
    "knip": "DATABASE_URL=${DATABASE_URL:-postgres://placeholder@localhost:5432/placeholder} knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm knip",
    "dev:wipe": "NODE_OPTIONS=--conditions=development node --import tsx scripts/env-reset.ts",
    "dev:seed": "NODE_OPTIONS=--conditions=development tsx scripts/seed-dev.ts",
    "db:migrate": "pnpm --filter @timeline/db migrate",
    "db:generate": "pnpm --filter @timeline/db generate",
    "db:studio": "pnpm --filter @timeline/db studio",
    "doctor": "node scripts/run-react-doctor.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sentry/cli": "3.5.1",
    "@timeline/db": "workspace:*",
    "@timeline/shared": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.17.1",
    "prettier": "^3.8.4",
    "react-doctor": "^0.5.8",
    "tsx": "^4.22.4",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.8.0"
  }
}
